; Daraja credentials for this installation — TEMPLATE ONLY, no real values.
;
; Copy to  <parent of project root>/keychele_secrets/daraja.ini
; (the same out-of-webroot directory that holds encryption.key; see
; msanii/includes/crypto.php → kc_secrets_dir()) and fill in the values.
; Never commit the real file. Restrict it to the web-server user (chmod 640).
;
; Values saved later in Admin01 → Settings → Daraja API Credentials take
; precedence over this file, and KC_DARAJA_* environment variables take
; precedence over this file too (KC_DARAJA_CONSUMER_KEY, KC_DARAJA_CONSUMER_SECRET,
; KC_DARAJA_PASSKEY, KC_DARAJA_SHORTCODE, KC_DARAJA_B2C_SHORTCODE,
; KC_DARAJA_INITIATOR_NAME, KC_DARAJA_SECURITY_CREDENTIAL,
; KC_DARAJA_ENVIRONMENT, KC_DARAJA_CALLBACK_BASE_URL).

consumer_key        = ""
consumer_secret     = ""
passkey             = ""
shortcode           = "4032885"
; Leave blank to use the Paybill above for B2C payouts.
b2c_shortcode       = ""
initiator_name      = ""
security_credential = ""
; sandbox | production
environment         = "production"
callback_base_url   = "https://keychele.co.ke"
